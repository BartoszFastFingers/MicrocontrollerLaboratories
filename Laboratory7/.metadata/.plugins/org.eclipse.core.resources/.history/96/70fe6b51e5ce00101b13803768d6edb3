void ADC2_Read_All(void)
{



    HAL_ADC_Start(&hadc2);
    HAL_ADC_PollForConversion(&hadc2, HAL_MAX_DELAY);
    adc2_raw[0] = HAL_ADC_GetValue(&hadc2);



    HAL_ADC_PollForConversion(&hadc2, HAL_MAX_DELAY);
    adc2_raw[1] = HAL_ADC_GetValue(&hadc2);


    // Convert to mV
    adc2_mv[0] = (adc2_raw[0] * 3300) / 4095;
    adc2_mv[1] = (adc2_raw[1] * 3300) / 4095;
}


void ADC3_Read_Multi(void)
{




    HAL_ADC_Start(&hadc3);
    HAL_ADC_PollForConversion(&hadc3, HAL_MAX_DELAY);
    adc_raw[0] = HAL_ADC_GetValue(&hadc3);




    HAL_ADC_PollForConversion(&hadc3, HAL_MAX_DELAY);
    adc_raw[1] = HAL_ADC_GetValue(&hadc3);


    adc_mv[0] = (adc_raw[0] * 3300) / 4095;
    adc_mv[1] = (adc_raw[1] * 3300) / 4095;
}

uint32_t ADC3_Read(void)
{
    HAL_ADC_Start(&hadc3);                                     // Start ADC
    HAL_ADC_PollForConversion(&hadc3, HAL_MAX_DELAY);          // Wait
    uint32_t value = HAL_ADC_GetValue(&hadc3);                 // Read
    HAL_ADC_Stop(&hadc3);                                      // Stop
    return value;
}

uint32_t ADC_To_mV(uint32_t adc_value)
{
    return (adc_value * 3300) / 4095;
}

uint32_t ADC2_To_mV(uint32_t adc_val)
{
    return (adc_val * 3300) / 4095;
}

void LED_Line_Update(uint32_t voltage_mv)
{
    HAL_GPIO_WritePin(LD1_GPIO_Port, LD1_Pin, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(LD3_GPIO_Port, LD3_Pin, GPIO_PIN_RESET);

    if (voltage_mv > 3000)
            HAL_GPIO_WritePin(LD3_GPIO_Port, LD3_Pin, GPIO_PIN_SET);

    if (voltage_mv >= 2000)
           HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, GPIO_PIN_SET);

    if (voltage_mv >= 1000)
        HAL_GPIO_WritePin(LD1_GPIO_Port, LD1_Pin, GPIO_PIN_SET);
}

void ADC_Send_UART(uint32_t adc_value_mv)
{
    char buffer[50];
    int len = snprintf(buffer, sizeof(buffer), "ADC value: %lu mV\r\n", adc_value_mv);
    HAL_UART_Transmit(&huart2, (uint8_t*)buffer, len, HAL_MAX_DELAY);
}

#include <math.h>
#include <stdint.h>

// Fotorezystor 10kΩ + 10kΩ dzielnik
float Photo_CalcLux(uint32_t adc_mv)
{
    if (adc_mv < 1) adc_mv = 1;       // zabezpieczenie
    const float Vref = 3300.0f;       // mV
    const float R_FIXED = 10000.0f;   // 10kΩ

    float R_photo = R_FIXED * (float)adc_mv / (Vref - (float)adc_mv);

    const float A = 6000.0f;  // dopasowany do LDR 10kΩ
    const float B = 0.8f;

    float lux = powf(A / R_photo, 1.0f / B);

    return lux;
}

float NTC_CalcTemp(uint32_t adc_mv)
{
    if (adc_mv < 1) adc_mv = 1;

    const float Vref = 3300.0f;      // mV
    const float R_FIXED = 10000.0f;  // rezystor 10kΩ
    const float B = 3950.0f;
    const float T0 = 298.15f;        // 25°C w K
    const float R0 = 10000.0f;       // rezystancja NTC w 25°C

    // odwrócony dzielnik
    float Rntc = R_FIXED * (Vref / (float)adc_mv - 1.0f);

    float invT = (1.0f / T0) + (1.0f / B) * logf(Rntc / R0);

    float temp_C = (1.0f / invT) - 323.15f;

    return temp_C;
}





void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
{
    if(GPIO_Pin == B1_Pin)
    {
    	ADC3_Read_Multi();
    	ADC2_Read_All();

    	float lux = Photo_CalcLux(adc2_mv[0]);
    	float temp = NTC_CalcTemp(adc2_mv[1]);

    	char buffer[200];
    	int len = snprintf(buffer, sizeof(buffer),
    	                   "ADC3: ch1=%lumV ch2=%lumV | PHOTO=%lumV lux=%.1f | NTC=%lumV temp=%.2fC\r\n",
    	                   adc_mv[0], adc_mv[1],
    	                   adc2_mv[0], lux,
    	                   adc2_mv[1], temp);

    	HAL_UART_Transmit(&huart2, (uint8_t*)buffer, len, HAL_MAX_DELAY);

    }
}



